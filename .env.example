GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Local development only. Copy these database settings into your local .env.
POSTGRES_USER=incidentclue
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=incidentclue
INCIDENTCLUE_POSTGRES_PORT=55432
INCIDENTCLUE_WEB_PORT=8000
# Host CLI uses localhost; the durable Compose service uses hostname postgres.
INCIDENTCLUE_DATABASE_URL=postgresql://incidentclue:local-development-only@localhost:55432/incidentclue

# RAG support is included; retrieval remains disabled until a corpus is selected.
# Optional host directory with verified local model files (defaults to ./models).
# INCIDENTCLUE_RAG_MODEL_DIR=C:/absolute/path/to/model
# Set the corpus ID printed by explicit ingestion to enable new investigations.
INCIDENTCLUE_RAG_CORPUS_ID=
