# Allow only the backend build inputs into the build context.
**
!backend/
!backend/Dockerfile
!backend/pyproject.toml
!backend/README.md
!backend/MANIFEST.in
!backend/requirements-dev.lock.txt
!backend/requirements-runtime.lock.txt
!backend/requirements-rag.candidate.txt
!backend/requirements-rag.lock.txt
!backend/src/
!backend/src/incidentclue/
!backend/src/incidentclue/*.py
!backend/src/incidentclue/**
!data/
!data/runbooks/
!data/runbooks/*.md
!data/runbooks/manifest.json
!.dockerignore
.venv/
backend/.pytest_cache/
**/__pycache__/
